generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum NewsAnalysisStatus {
  PENDING
  ANALYZED
  FAILED
}

enum PredictionDirection {
  BUY
  SELL
  NEUTRAL
}

enum PredictionStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum PredictionSourceType {
  SINGLE_NEWS
  GLOBAL_CONTEXT
}

enum AgentRunStatus {
  SUCCESS
  FAILED
}

model NewsItem {
  id              String             @id @default(cuid())
  externalId      String?            @unique
  idApi           String?            @unique
  dateline        Int?
  eventStartAt    DateTime?
  eventEndAt      DateTime?
  impactValue     Int?
  forecast        String?
  previous        String?
  eventTime       String?
  eventDate       String?
  source          String
  title           String
  url             String?
  summary         String?
  rawPayload      Json?
  publishedAt     DateTime
  analysisStatus  NewsAnalysisStatus @default(PENDING)
  analysisSummary String?
  category        String?
  impactLevel     String?
  goldImpact      String?
  analyzedAt      DateTime?
  analysisError   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  predictions Prediction[]

  @@index([analysisStatus])
  @@index([eventStartAt])
}

model MarketContextAnalysis {
  id              String              @id @default(cuid())
  globalBias      PredictionDirection
  confidence      Int
  summary         String
  activeDrivers   Json?
  riskNotes       Json?
  newsWindowStart DateTime
  newsWindowEnd   DateTime
  createdAt       DateTime            @default(now())

  predictions Prediction[]
}

model Prediction {
  id                          String               @id @default(cuid())
  newsItemId                  String?
  direction                   PredictionDirection
  confidence                  Int
  expectedMovePercent         Float?
  timeframeMinutes            Int
  reason                      String
  status                      PredictionStatus     @default(PENDING)
  sourceType                  PredictionSourceType @default(SINGLE_NEWS)
  priceAtPrediction           Float?
  eventStartAt                DateTime?
  eventEndAt                  DateTime?
  priceAtEventStart           Float?
  priceAtEventEnd             Float?
  checkAfter                  DateTime
  validFrom                   DateTime?
  validUntil                  DateTime?
  expiresAt                   DateTime?
  globalContextId             String?
  invalidationReason          String?
  appliedPromptImprovementIds Json?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  newsItem      NewsItem?              @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  globalContext MarketContextAnalysis? @relation(fields: [globalContextId], references: [id], onDelete: SetNull)
  result        PredictionResult?

  @@index([status])
  @@index([newsItemId])
  @@index([globalContextId])
  @@index([sourceType])
  @@index([eventEndAt])
}

model AgentRun {
  id        String         @id @default(cuid())
  agentName String
  input     Json?
  output    Json?
  status    AgentRunStatus
  error     String?
  createdAt DateTime       @default(now())

  @@index([agentName])
}

model MarketPriceSnapshot {
  id         String   @id @default(cuid())
  symbol     String   @default("XAUUSD")
  price      Float
  source     String
  capturedAt DateTime
  rawPayload Json?
  createdAt  DateTime @default(now())

  @@index([symbol, capturedAt])
}

model PredictionResult {
  id                  String   @id @default(cuid())
  predictionId        String   @unique
  priceBefore         Float
  priceAfter          Float
  actualMovePercent   Float
  isSuccess           Boolean
  directionCorrect    Boolean?
  moveAccuracyPercent Float?
  finalScore          Float?
  baselineSource      String?
  explanation         String?
  evaluatedAt         DateTime
  createdAt           DateTime @default(now())

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
}

/// Reusable prompt/reasoning improvements — never market conclusions.
model PromptImprovement {
  id                 String    @id @default(cuid())
  problemType        String
  rootCause          String
  promptImprovement  String
  confidence         Int?
  sourcePredictionId String?
  isDeprecated       Boolean   @default(false)
  occurrences        Int       @default(1)
  usageCount         Int       @default(0)
  timesApplied       Int       @default(0)
  successCount       Int       @default(0)
  failureCount       Int       @default(0)
  successRate        Float?
  lastAppliedAt      DateTime?
  /// Legacy market-rule fields — do not use in prompts
  title              String?
  description        String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([isDeprecated, createdAt])
  @@map("LearningRule")
}

model ServerLog {
  id        String   @id @default(cuid())
  type      String
  message   String
  level     String   @default("info")
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
}
