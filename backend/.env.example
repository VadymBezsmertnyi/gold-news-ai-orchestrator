DATABASE_URL="postgresql://user:password@localhost:5432/gold_news_orchestrator?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/gold_news_orchestrator?schema=public"
METAAPI_TOKEN=""
METAAPI_ACCOUNT_ID=""
METAAPI_SYMBOL="XAUUSD"
NODE_ENV="development"
PORT=3001
#Claude
CLAUDE_API_KEY=""
#OpenAI
OPENAI_API_KEY=""
OPENAI_ORG_ID=""
OPENAI_PROJECT_ID=""
#LLM
LLM_DEFAULT_PROVIDER="mock"
CLAUDE_MODEL_FAST="claude-haiku-4-5"
CLAUDE_MODEL_SMART="claude-sonnet-4-6"
OPENAI_MODEL_FAST="gpt-4.1-mini"
OPENAI_MODEL_SMART="gpt-4.1"
# Global market context scheduling (agents use fixed providers; mock via LLM_DEFAULT_PROVIDER=mock)
GLOBAL_CONTEXT_COOLDOWN_MINUTES=10
GLOBAL_CONTEXT_SCHEDULE_MINUTES=30
# Learning agent threshold (runs only on failed SINGLE_NEWS predictions)
LEARNING_AGENT_MIN_CONFIDENCE=60
# Event-start baseline (live window ±sec, capture batch, MetaAPI candle max skew)
EVENT_START_CAPTURE_WINDOW_SECONDS=30
EVENT_START_CAPTURE_BATCH_LIMIT=10
METAAPI_HISTORY_MAX_CANDLE_DIFF_SECONDS=900